# Copia este archivo como .env.local y completa los valores (.env.local no se sube a git).

# URL de chunky-api. Si se omite, se usa produccion: https://chunky-api-production.up.railway.app
# Para desarrollo local: http://localhost:3000
VITE_API_BASE_URL=

# Llave que valida chunky-api en el header x-api-key (API_KEY del entorno de ese API).
# Es distinta en local y en Railway.
VITE_API_KEY=

# true para mostrar solo la vista de mantenimiento en todas las rutas.
VITE_MAINTENANCE_MODE=false
